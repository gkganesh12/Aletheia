{
  "name": "@aletheia/agents",
  "version": "1.0.0",
  "private": true,
  "description": "Aletheia AI Dev Workflow Agents — TypeScript + Claude API",
  "type": "module",
  "bin": {
    "agents": "./dist/orchestrator/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/orchestrator/index.ts",
    "start": "tsx src/orchestrator/index.ts",
    "run:pipeline": "tsx src/orchestrator/index.ts run",
    "run:agent": "tsx src/orchestrator/index.ts run --agent",
    "status": "tsx src/orchestrator/index.ts status",
    "reset": "tsx src/orchestrator/index.ts reset",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "diff": "^7.0.0",
    "ejs": "^3.1.10",
    "glob": "^11.0.0",
    "inquirer": "^12.3.0",
    "js-yaml": "^4.1.0",
    "ora": "^8.1.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/diff": "^6.0.0",
    "@types/ejs": "^3.1.5",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
